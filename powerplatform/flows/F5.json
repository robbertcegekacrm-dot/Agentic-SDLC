{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cgk_sdlc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "storytype": {
                  "type": "string",
                  "title": "storytype",
                  "description": "New feature, Issue, Improvement or Question",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "title": {
                  "type": "string",
                  "title": "title",
                  "description": "Short title",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "description": {
                  "type": "string",
                  "title": "description",
                  "description": "What the user wants or what happened",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "steps": {
                  "type": "string",
                  "title": "steps",
                  "description": "Where it happened / steps (issues)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "expected": {
                  "type": "string",
                  "title": "expected",
                  "description": "What was expected (issues)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "userprincipalname": {
                  "type": "string",
                  "title": "userprincipalname",
                  "description": "UPN of the reporter",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "storytype",
                "title",
                "description"
              ]
            }
          }
        }
      },
      "actions": {
        "Type_values": {
          "type": "Compose",
          "inputs": {
            "New feature": 766630000,
            "Issue": 766630001,
            "Improvement": 766630002,
            "Change request": 766630003,
            "Technical debt": 766630004,
            "Question": 766630005
          }
        },
        "Find_reporter": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "$select": "systemuserid",
              "$filter": "domainname eq '@{coalesce(triggerBody()?['userprincipalname'], '-')}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Type_values": [
              "Succeeded"
            ]
          }
        },
        "Create_story": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cgk_sdlcstories",
              "item/cgk_title": "@{triggerBody()?['title']}",
              "item/cgk_description": "@{triggerBody()?['description']}",
              "item/cgk_stepstoreproduce": "@{coalesce(triggerBody()?['steps'], '')}",
              "item/cgk_expectedvsactual": "@{coalesce(triggerBody()?['expected'], '')}",
              "item/cgk_type": "@coalesce(outputs('Type_values')?[triggerBody()?['storytype']], 766630001)",
              "item/cgk_channel": 766630000,
              "item/cgk_ReportedBy@odata.bind": "@{if(empty(outputs('Find_reporter')?['body/value']), null, concat('systemusers(', first(outputs('Find_reporter')?['body/value'])?['systemuserid'], ')'))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Find_reporter": [
              "Succeeded"
            ]
          }
        },
        "Log_intake": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cgk_agentactivities",
              "item/cgk_name": "Story created",
              "item/cgk_action": "Create SDLC story",
              "item/cgk_agent": 766630000,
              "item/cgk_outcome": 766630003,
              "item/cgk_details": "@{outputs('Create_story')?['body/cgk_storynumber']} reported via Teams by @{coalesce(triggerBody()?['userprincipalname'], 'an employee')}.",
              "item/cgk_timestamp": "@utcNow()",
              "item/cgk_SDLCStory@odata.bind": "cgk_sdlcstories(@{outputs('Create_story')?['body/cgk_sdlcstoryid']})"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Create_story": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_the_agent": {
          "type": "Response",
          "kind": "Skills",
          "runAfter": {
            "Log_intake": [
              "Succeeded"
            ]
          },
          "inputs": {
            "statusCode": 200,
            "body": {
              "storynumber": "@{outputs('Create_story')?['body/cgk_storynumber']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "storynumber": {
                  "title": "storynumber",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}