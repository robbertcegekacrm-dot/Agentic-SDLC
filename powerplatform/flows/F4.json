{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cgk_sdlc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cgk_sdlc_teams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "storyId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "storyId",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "version",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "version",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "deployUrl",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "deployUrl",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2"
              ]
            }
          }
        }
      },
      "actions": {
        "Get_story": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cgk_sdlcstories",
              "recordId": "@triggerBody()?['text']",
              "$select": "cgk_storynumber,cgk_title,_cgk_reportedby_value"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Get_reporter": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "recordId": "@{outputs('Get_story')?['body/_cgk_reportedby_value']}",
              "$select": "internalemailaddress,firstname"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Get_story": [
              "Succeeded"
            ]
          }
        },
        "Post_Teams_message": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Get_reporter": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_teams",
              "operationId": "PostMessageToConversation",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
            },
            "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@{outputs('Get_reporter')?['body/internalemailaddress']}",
              "body/messageBody": "<p>Hi @{outputs('Get_reporter')?['body/firstname']}, 🚀 <b>@{outputs('Get_story')?['body/cgk_storynumber']}</b> \"@{outputs('Get_story')?['body/cgk_title']}\" is live in release <b>@{triggerBody()?['text_1']}</b>: <a href=\"@{triggerBody()?['text_2']}\">@{triggerBody()?['text_2']}</a></p>"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Log_notified": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cgk_agentactivities",
              "item/cgk_name": "Reporter notified in Teams",
              "item/cgk_action": "Notify reporter",
              "item/cgk_agent": 766630004,
              "item/cgk_outcome": 766630003,
              "item/cgk_details": "Teams message sent to @{outputs('Get_reporter')?['body/internalemailaddress']}.",
              "item/cgk_timestamp": "@utcNow()",
              "item/cgk_SDLCStory@odata.bind": "cgk_sdlcstories(@{triggerBody()?['text']})"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Post_Teams_message": [
              "Succeeded"
            ]
          }
        },
        "Log_notify_failed": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cgk_agentactivities",
              "item/cgk_name": "Reporter not notified",
              "item/cgk_action": "Notify reporter",
              "item/cgk_agent": 766630004,
              "item/cgk_outcome": 766630001,
              "item/cgk_details": "The Teams message could not be sent.",
              "item/cgk_timestamp": "@utcNow()",
              "item/cgk_SDLCStory@odata.bind": "cgk_sdlcstories(@{triggerBody()?['text']})"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Post_Teams_message": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Respond": {
          "type": "Response",
          "kind": "PowerApp",
          "runAfter": {
            "Log_notified": [
              "Succeeded",
              "Skipped"
            ],
            "Log_notify_failed": [
              "Succeeded",
              "Skipped"
            ]
          },
          "inputs": {
            "statusCode": 200,
            "body": {
              "notified": "@{if(equals(actions('Post_Teams_message')?['status'], 'Succeeded'), 'yes', 'no')}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "notified": {
                  "title": "notified",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}