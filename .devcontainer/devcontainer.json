{
  "name": "cegeka-dataverse-demo-toolkit",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "postCreateCommand": "dotnet tool install --global Microsoft.PowerApps.CLI.Tool && curl -fsSL https://claude.ai/install.sh | bash",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.dotnet/tools"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "microsoft-IsvExpTools.powerplatform-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
